<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DotCourier.EntityFrameworkCore</PackageId>
    <Description>EF Core transactions for DotCourier: every command runs in a transaction that commits on success and rolls back on exceptions or error responses, with after-commit actions for side effects.</Description>
    <RootNamespace>DotCourier.EntityFrameworkCore</RootNamespace>
    <PackageTags>$(PackageTags);entityframeworkcore;efcore;transactions;unitofwork</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotCourier\DotCourier.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotCourier.Tests" />
  </ItemGroup>

</Project>
