<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DotCourier.FluentValidation</PackageId>
    <Description>FluentValidation integration for DotCourier: IValidator&lt;T&gt; runs in the pipeline's validation step, and FluentValidation's ValidationException becomes a 400 response instead of a 500.</Description>
    <RootNamespace>DotCourier.FluentValidation</RootNamespace>
    <PackageTags>$(PackageTags);validation;fluentvalidation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotCourier\DotCourier.csproj" />
  </ItemGroup>

</Project>
