<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DotCourier.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for DotCourier: turn a Response&lt;T&gt; into an IResult (Minimal APIs) or IActionResult (MVC) carrying its status code.</Description>
    <RootNamespace>DotCourier</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotCourier\DotCourier.csproj" />
  </ItemGroup>

</Project>
