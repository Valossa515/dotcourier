<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.2.0</Version>
    <Authors>Valossa515</Authors>
    <Copyright>Copyright (c) 2026 Felipe Martins</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Valossa515/dotcourier</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Valossa515/dotcourier</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mediator;cqrs;mediatr;pipeline;behaviors;outbox</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
