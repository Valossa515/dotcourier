<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Library dependencies: pinned to the 8.0 line so net8.0 consumers are not forced up. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />

    <!-- DotCourier.Resilience -->
    <PackageVersion Include="Polly.Core" Version="8.8.0" />
    <PackageVersion Include="Polly.RateLimiting" Version="8.8.0" />

    <!-- DotCourier.FluentValidation -->
    <PackageVersion Include="FluentValidation" Version="12.2.0" />

    <!-- DotCourier.Caching: 9.x line keeps Microsoft.Extensions.* on 9.0 for net8.0 consumers -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="9.10.0" />

    <!-- DotCourier.EntityFrameworkCore: EF 8 runs on net8.0 and net10.0; apps on EF 9/10 lift it -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.32" />

    <!-- DotCourier.Outbox.EntityFrameworkCore: background processor -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />

    <!-- DotCourier.Kafka -->
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />

    <!-- DotCourier.SourceGenerator: Roslyn 4.8 = .NET SDK 8.0.100, the oldest SDK DotCourier supports -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />

    <!-- Test-only -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.32" />
    <PackageVersion Include="Testcontainers.Kafka" Version="4.16.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
