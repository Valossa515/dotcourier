<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Published with Native AOT by CI and run: proves DotCourier works without runtime code generation.
    Any trimming or AOT warning fails the publish (TreatWarningsAsErrors).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- -p:TrimOnly=true runs only the trimming analysis (ILLink): no native toolchain needed, e.g. on Windows without the C++ workload. -->
    <PublishAot Condition="'$(TrimOnly)' != 'true'">true</PublishAot>
    <PublishTrimmed Condition="'$(TrimOnly)' == 'true'">true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!--
      Microsoft.Extensions.Caching.Hybrid's built-in JSON serializer uses reflection and is reachable from
      AddHybridCache, so any trimmed or AOT app using HybridCache gets these from that assembly (9.x and 10.x
      alike; ILC adds IL3050 for the same code).
      DotCourier registers its own serializer (ResultSerializerOptions), so that code never runs for its types.
      They stay warnings here; the same codes in DotCourier's own code are errors at build time
      (IsAotCompatible analyzers on every DotCourier package this app uses).
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL2070;IL2104;IL3050</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotCourier\DotCourier.csproj" />
    <ProjectReference Include="..\..\src\DotCourier.AspNetCore\DotCourier.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\DotCourier.Caching\DotCourier.Caching.csproj" />
    <ProjectReference Include="..\..\src\DotCourier.Resilience\DotCourier.Resilience.csproj" />
    <ProjectReference Include="..\..\src\DotCourier.SourceGenerator\DotCourier.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
